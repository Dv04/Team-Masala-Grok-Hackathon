# Real departments service (dev4). Events are posted here by default, including on localhost.
DEPARTMENTS_BASE_URL=http://localhost:8810

# Company dashboard. Defaults to DEPARTMENTS_BASE_URL.
DASHBOARD_BASE_URL=http://localhost:8810

# One listen port for REST, MCP (POST /mcp), the mock contract, and the webhook receiver.
# Forbidden: 8000, 3100, 8790, 8792, 8810.
WEBHOOK_PORT=8811
WEBHOOK_PATH=/api/webhooks/inbound

# Event mode is live when posting to the departments service. Set mock only for the in-process tests.
# TOOLS_MODE=mock

# Grok. /health reports sales, support, and engineering live when XAI_API_KEY starts with xai-
# or when XAI_BASE_URL is set together with a key. Leave the key blank to stay on labeled mock copy.
# XAI_API_KEY=
# XAI_BASE_URL=https://api.x.ai/v1
# XAI_MODEL=grok-4
# XAI_BUDGET_USD=1

# Ops sweep inside the mock contract.
OPS_SWEEP_MS=60000
OPS_STUCK_AFTER_MS=60000

# Live adapters. Leave blank tonight. Never commit real keys.
TWENTY_BASE_URL=
TWENTY_API_KEY=
OPENOUTREACH_BIN=
REACHER_BASE_URL=
WARMBLY_BASE_URL=
WARMBLY_API_KEY=
CHATWOOT_BASE_URL=
CHATWOOT_API_TOKEN=
CHATWOOT_ACCOUNT_ID=
INBOX_ZERO_MCP_URL=
RAGFLOW_BASE_URL=
RAGFLOW_API_KEY=
OPENHANDS_BASE_URL=
OPENHANDS_API_KEY=
GITHUB_TOKEN=
GITHUB_ISSUE=
