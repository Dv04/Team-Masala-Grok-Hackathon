# Real departments service (dev4). Events are posted here by default, including on localhost.
DEPARTMENTS_BASE_URL=http://localhost:8810

# Company dashboard. Defaults to DEPARTMENTS_BASE_URL.
DASHBOARD_BASE_URL=http://localhost:8810

# One listen port for REST, MCP (POST /mcp), the mock contract, and the webhook receiver.
# Forbidden: 8000, 3100, 8790, 8792, 8810.
WEBHOOK_PORT=8811
WEBHOOK_PATH=/api/webhooks/inbound

# Event mode is mock unless XAI_API_KEY starts with xai-. Set mock to force the in-process tests.
# TOOLS_MODE=mock

# Live Grok on the demo host. Leave the key blank to stay on labeled MOCK.
# Prices are estimates (grok-4.3 short context). The ledger is data/xai-budget.json.
XAI_API_KEY=
XAI_BUDGET_USD=2
XAI_MODEL=grok-4.3
XAI_BASE_URL=https://api.x.ai/v1
XAI_MAX_OUTPUT_TOKENS=120

# Ops sweep inside the mock contract.
OPS_SWEEP_MS=60000
OPS_STUCK_AFTER_MS=60000

# Live adapters. Leave blank tonight. Never commit real keys.
TWENTY_BASE_URL=
TWENTY_API_KEY=
OPENOUTREACH_BIN=
REACHER_BASE_URL=
WARMBLY_BASE_URL=
WARMBLY_API_KEY=
CHATWOOT_BASE_URL=
CHATWOOT_API_TOKEN=
CHATWOOT_ACCOUNT_ID=
INBOX_ZERO_MCP_URL=
RAGFLOW_BASE_URL=
RAGFLOW_API_KEY=
OPENHANDS_BASE_URL=
OPENHANDS_API_KEY=
GITHUB_TOKEN=
GITHUB_ISSUE=
