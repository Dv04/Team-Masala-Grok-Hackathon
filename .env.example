# Grok provider mode. Use `mock` for local development with no API keys.
GROK_PROVIDER_MODE=mock

# xAI API key for real provider integration (server-side only).
# Leave empty for local mock mode.
XAI_API_KEY=

# Optional custom endpoint if official xAI docs provide a different base URL.
XAI_BASE_URL=https://api.x.ai/v1
