# TASKS.toon: derived from PLAN.md. Status of every task: todo. Times are minutes. Clock: 6:40 PM CT, freeze 7:30 PM CT.
# Workers: W1 = engine (owns server.py; others ship modules exposing register(mcp) and W1 adds one import line each),
#          W2 = dashboard, W3 = ops/inbound/routines/tests. "parallel" = which group may run concurrently.
# Must-have wall clock is about 53 min: W1 T01>T02>T03>T08 = 35, W2 T07>T09 = 26, W3 T05>T06>T04>T10>T11 = 40, then T12 10 + T13 8.
# Must-have total work is 119 worker-min. If time is short, cut T10's live routine creation (keep ROUTINES.md) and T09 first.
meta:
  plan: /workspace/departments/PLAN.md
  service: http://127.0.0.1:8810
  statuses: queued|running|needs_approval|approved|rejected|done|failed
  freeze: "2026-10-19 7:30 PM CT"
tasks[29]{id,title,dept,worker,depends,est_min,priority,parallel,acceptance,status}:
  T01,"Automation engine core lib/auto.py: HOOKS enqueue -> worker thread, rule table, idempotency file data/auto_seen.json, actor auto, parent_id chain, 5-hop guard",all,W1,"[]",12,must,A,"POST a hire_needed event -> within 3s a new hr queued event with actor=auto and parent_id=trigger; restart service -> no duplicate run; GET /api/automation/rules lists rules",done
  T02,"Action executors: outbox .eml (fictional recipients), design publish to data/published/<task>/, ATS data/hr/pipeline.json, tasks.jsonl + webhook; done event with output.action{type,path,executed_by}",all,W1,"[T01]",10,must,A,"QA-pass design run -> data/published/<task>/caption.json exists and a done event has output.action.path; file names keep .MOCK when mode=mock",done
  T03,"Founder path: Approve -> executor runs (executed_by founder); Reject -> logged, dept revises once with note -> QA again; 2nd reject -> failed; QA fail -> revise once",hr|design|qa,W1,"[T02]",8,must,A,"approve pending HR task -> data/outbox/<task>.eml + ATS stage contacted; reject twice -> final status failed; caption with email -> fail -> revised -> pass -> published",done
  T04,"Cross-dept chain rules: engineering hire_needed->HR; sales|marketing|support design_request->Design; any event output.needs_qa:true->auto qa.check + verdict webhook; ops task->target dept (rules in lib/chains.py, registered into auto.py)",all,W3,"[T01]",8,must,A,"each of 4 chains triggered by a single POST /api/events reaches done or needs_approval with no other call; chain visible via parent_id",done
  T05,"Inbound webhooks POST /api/inbound/{dept} (hr job/resume, design brief, generic) + POST/GET /api/tasks?dept= backed by data/tasks.jsonl (lib/inbound.py register(mcp))",hr|design|all,W3,"[]",6,must,B,"curl POST /api/inbound/design {brand,brief} -> design chain runs; GET /api/tasks?dept=support returns ops-created tasks",done
  T06,"Ops scheduler lib/sched.py: 60s thread + MCP ops.scan; anomalies (approval >10min, running >5min, dept fail rate >30%) -> create task for dept (internal QA pass) + scan event; dedupe per anomaly",ops,W3,"[T05]",10,must,B,"seed a needs_approval event with ts 11 min old -> next scan (or ops.scan call) creates exactly one task for that dept and logs it; second scan creates none",done
  T07,"Dashboard static/dashboard.html: 13 dept tiles (owner, last status, counts, MOCK/LIVE badge), live feed (2s poll, actor + parent), approval queue with preview + note + Approve/Reject, KPIs, founder-away toggle, MOCK + sandbox banners, Run demo button",dashboard,W2,"[]",20,must,C,"open /dashboard in box Chrome: tiles render with no events; posting an event shows in feed <=2s; clicking Approve removes the item and a done/action event appears <=2s; no console errors",done
  T08,"Serve dashboard + files: GET /dashboard, GET /files/{published|outbox|design-out}/... (path-safe), GET /api/automation/rules wired in server.py",dashboard,W1,"[T01,T07]",5,must,A,"curl /dashboard 200 text/html; /files/../etc/passwd -> 400; published asset opens in browser",done
  T09,"Rules panel + action links in feed (click event -> output JSON + link to .eml / asset)",dashboard,W2,"[T07,T08]",6,must,C,"rules panel lists every rule from /api/automation/rules; clicking a done event with output.action opens the file",done
  T10,"Grok Bot routines: ROUTINES.md with 2 saved prompts (scheduled ops scan every 15 min -> ops.scan/ops.kpis + PR #2 digest; GitHub-triggered on PR #2 comment 'hire needed'/'design request' -> POST /api/events actor grok-routine); create 1 routine via parent (needs Dhi approval) and verify it reaches 127.0.0.1:8810 from the box",all,W3,"[T06]",10,must,B,"one routine run produces an event with actor=grok-routine visible on the dashboard; if same-box access fails, documented as blocker",done
  T11,"demo.sh: reset.sh, founder away on, fire the chain triggers from PLAN section 4 with sleeps, away off; plus Run demo button calls the same seed via POST /api/demo/seed",all,W3,"[T04,T05]",6,must,B,"./demo.sh on a clean log -> dashboard shows HR needs_approval, Design published, QA revise->pass, ops task; finishes in <90s",done
  T12,"Extend smoke.py: chains 1-4, approve->execute, reject->revise->fail, idempotency on restart, scheduler dedupe, dashboard 200, files path-safety; keep the 31 old checks",qa,W3,"[T03,T04,T06,T08]",10,must,D,"python smoke.py prints N/N passed with real counts; any failure fixed or reported, never claimed",done
  T13,"README update (automation, dashboard, routines, mock vs live, credits/licenses) + hand code to cloud agent for branch dev4 (no secrets, no data/*.jsonl logs, .gitignore)",all,W1,"[T12]",8,must,D,"branch dev4 on GitHub contains the service, PLAN.md, TASKS.toon, README; git grep finds no xai-/sk- keys",todo
  N01,"SSE /api/stream replacing polling (fallback to polling kept)",dashboard,W2,"[T07]",10,nice,C,"feed updates <500ms after an event; killing SSE falls back to 2s poll",done
  N02,"'While you were away' digest: on away->off, ops writes data/digests/<ts>.md (actions auto-executed, pending approvals, anomalies) and dashboard shows it",ops,W3,"[T06]",8,nice,B,"toggle away on, run demo, toggle off -> digest file + dashboard card with correct counts",todo
  N03,"Live xAI rehearsal once XAI_API_KEY arrives (secret via env only): HR live, Design live (<=3 images), QA rubric; badges flip to LIVE",hr|design|qa,W1,"[T13]",10,nice,E,"one live run per dept succeeds, or the real error is reported; mode=live only on those events",todo
  N04,"Public URL: put Dhi's domain/tunnel in front of 8810 (bind via proxy, not 0.0.0.0 blindly); share /mcp + /dashboard with dev2",all,W1,"[T13]",10,nice,E,"curl https://<domain>/health 200 from outside; dev2 posts one event",todo
  N05,"promptfoo MCP on (WITH_PROMPTFOO=1) visible in dashboard tools list",qa,W3,"[T12]",5,nice,E,"port 3100 answers MCP tools/list",todo
  N06,"Real sandbox email channel (test inbox provider) after founder approval only; default stays outbox",all,W1,"[N03]",15,nice,E,"approved email lands in the sandbox inbox, not a real address; needs Dhi's choice + key",todo
  X01,"[combined] HR: JD writer + 30/60/90 onboarding from ai-recruiter-claude (MIT) SKILL.md templates; onboarding file written on hire approval",hr,W1,"[T13]",12,nice,F,"hire_needed run output has jd; approving it writes data/hr/onboarding/<task>.md; mock labeled",done
  X02,"[combined] HR: blind screening + interview kit from agent-recruiter (MIT); blind:true strips PII before ranking; live via CLI with xAI base URL",hr,W1,"[T13]",12,nice,F,"blind run output has no names/emails in ranking input; interview_kit present; mock bank labeled",done
  X03,"[combined] Design: generate->score->retry on-brand loop (adk-recipes on-brand-genmedia pattern, Apache-2.0); live chat_with_vision, mock rule score",design,W2,"[T13]",12,nice,F,"each asset has brand_score; one forced low score triggers exactly one regenerate event",done
  X04,"[combined] Design: org chart board via mcp_excalidraw (MIT, npx, no key) exported into design-out and published",design,W2,"[T13]",15,nice,F,"design/run asset=org_chart writes .excalidraw (+png if supported); verify Node version first",todo
  X05,"[combined] Data/ops: dbhub (MIT) read-only SQL gateway + workbench over SQLite snapshot on :8080 (npx -p node@22)",ops,W3,"[T13]",12,nice,F,"dbhub execute_sql SELECT count(*) works; write statement rejected; workbench link on dashboard",todo
  X06,"[combined] Data/ops: WrenAI-style governed metrics data/metrics.yaml + ops.ask (MCP + /api/ops/ask); live Grok SQL limited to events view, mock keyword->metric",ops,W3,"[T13]",12,nice,F,"ops.ask 'pending approvals?' returns number + metric name + SQL used",done
  X07,"[combined] QA: openevals (MIT) hallucination/correctness judge as second judge when keyed; skipped label otherwise",qa,W1,"[N03]",10,nice,F,"keyed run shows openevals score in check_results; unkeyed shows skipped (no XAI_API_KEY)",done-label-only
  X08,"[combined] QA: promptfoo golden regression suite qa/golden.yaml (deterministic asserts, no key) against /api/qa/check + reliability tile",qa,W3,"[T13]",12,nice,F,"promptfoo eval reports real pass rate; tile shows it with run time",done
  X09,"README credits + license table for every combined feature added (only what was actually added)",all,W1,"[X01]",3,nice,F,"each added extra listed with repo, license, what was copied vs reimplemented",done
  X10,"Push combined features to dev4 (cloud agent)",all,W1,"[X09]",5,nice,F,"dev4 updated; smoke still N/N",todo
parallel_groups:
  A: "W1 sequential: T01>T02>T03>T08 (T08 also waits on T07)"
  B: "W3: T05>T06>T04 (T04 waits on T01)>T10>T11; starts at once"
  C: "W2: T07>T09 (starts at once), N01 after"
  D: "after A+B+C: T12 then T13 (the must-have finish line, target 7:30 PM CT)"
  E: "post-freeze nice-to-haves needing Dhi inputs (key, domain, email provider)"
  F: "combined features, only after D; X01-X08 independent of each other, up to 3 at once"
